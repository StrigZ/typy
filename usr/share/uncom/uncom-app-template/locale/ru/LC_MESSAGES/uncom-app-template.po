#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:34
#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:83
#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:166
msgid "AppImage Installer"
msgstr "Установщик AppImage"

#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:57
msgid ""
"This application may be installed into system. After that you can find it in menu <b>All applications</b>."
msgstr "Программа может быть установлена в систему, после чего будет доступна для запуска через иконку в меню \n<b>Все программы</b>."

#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:64
msgid "Launch"
msgstr "Запустить"

#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:69
msgid "Install"
msgstr "Установить"

#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:79
msgid "Application installed succeessfully."
msgstr "Программа установлена успешно."

#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:118
msgid "Error during installation: "
msgstr "Ошибка при установке: "

#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:88
msgid "Given AppImage file does not exist: "
msgstr "Данный файл AppImage не существует: "

#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:79
msgid "Installed"
msgstr "Установлено"

#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:107
msgid "Do you want to delete this application?"
msgstr "Вы уверены, что хотите удалить данную программу?"

#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:114
msgid "Yes"
msgstr "Да"

#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:121
msgid "No"
msgstr "Нет"

#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:143
msgid "Error"
msgstr "Ошибка"

#: usr/lib/uncom/uncom-manager-appimage/uncom-manager-appimage.py:223
msgid "This app allows to install AppImage applications into system and launch them via apps menu. Download any AppImage file and double click on it to launch or install."
msgstr "Данная программа позволяет устанавливать AppImage приложения в систему. Скачайте любой AppImage файл и дважды кликните по нему, чтобы запустить или установить."